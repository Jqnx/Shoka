# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with "go test -c"
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
tmp/

# IDE specific files
.vscode
.idea
.zed

# .env file
.env

# config file
config.yaml

# Project build
main

# OS X generated file
.DS_Store

# Asynq Webclient binary
asynqmon

# Tailwind CSS
cmd/web/assets/css/output.css
tailwindcss

# Directories
# Anchored on purpose: Tailwind's source scanner honours .gitignore, so a
# bare `audio/` silently drops any source dir of that name (it hid
# frontend/src/routes/(app)/audio and every utility in it).
/content/
/content-bak/
backend/thumb/
backend/data/
/cache/
/audio/

# Metadata files
ComicInfo.xml
info.txt
info.json
info.yaml
info.yml

# Notes
notes.txt

.agents/
.claude/
.pi/
/agent/
skills-lock.json
