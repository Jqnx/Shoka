# Drizzle
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# adapter-node defaults to 512KB and rejects larger request bodies before
# SvelteKit ever sees them. Avatar uploads are small (client-cropped to
# 512x512 before upload) but set some headroom above adapter-node's default.
# See frontend/src/lib/server/avatars.ts and $lib/schemas/avatar.
BODY_SIZE_LIMIT=2M

# Optional: where avatar files are written. Defaults to an `avatars/`
# directory next to DATABASE_URL - only set this if you want blob storage
# split from the DB file.
# AVATAR_DIR=
