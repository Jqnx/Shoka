# Copy to .env before `make run`. Read by docker-compose.yml only — the
# frontend dev server uses frontend/.env instead.

# Required. 32+ characters, high entropy: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The URL you browse to, including scheme and port. Behind a reverse proxy this
# is the public address, not the container's. A mismatch makes every form
# submission fail as a CSRF error.
ORIGIN=http://localhost:3000

# Host port published for the web UI.
SHOKA_PORT=3000

# Your doujinshi collection. Mounted read-write: Shoka injects ComicInfo.xml
# and converts 7z/rar archives to zip in place.
SHOKA_LIBRARY=./content

# The host user that owns SHOKA_LIBRARY — `id -u` and `id -g`.
PUID=1000
PGID=1000

TZ=UTC
LOG_LEVEL=info
